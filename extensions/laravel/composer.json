{
    "name": "erikwang2013/consul-php-laravel",
    "description": "Laravel integration for erikwang2013/consul-php",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "erikwang2013/consul-php": "*",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Erikwang2013\\Consul\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Erikwang2013\\Consul\\Laravel\\ConsulServiceProvider"
            ],
            "aliases": {
                "Consul": "Erikwang2013\\Consul\\Laravel\\Facades\\Consul"
            }
        }
    }
}
